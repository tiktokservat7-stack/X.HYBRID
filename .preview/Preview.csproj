<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>FNHybrid</RootNamespace>
    <AssemblyName>XHybridPreview</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FNHybridLauncher/*.cs" Exclude="../FNHybridLauncher/Program.cs" />
    <Compile Include="PreviewProgram.cs" />
    <EmbeddedResource Include="../FNHybridLauncher/Assets/LobbyHome.png" LogicalName="LobbyHome.png" />
    <EmbeddedResource Include="../FNHybridLauncher/Assets/LobbyHero.jpg" LogicalName="LobbyHero.jpg" />
    <EmbeddedResource Include="../FNHybridLauncher/Assets/EacLogo.png" LogicalName="EacLogo.png" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../FNHybridLauncher/payload.zip')">
    <EmbeddedResource Include="../FNHybridLauncher/payload.zip" LogicalName="payload.zip" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>FNHybrid</RootNamespace>
    <AssemblyName>X.HYBRID V1</AssemblyName>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- DLL embarquee dans l'exe : la version hebergee n'a besoin d'aucun fichier annexe -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgBouncyCastle_Cryptography)\lib\net461\BouncyCastle.Cryptography.dll" LogicalName="BouncyCastle.Cryptography.dll" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>

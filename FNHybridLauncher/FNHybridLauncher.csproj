<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>FNHybrid</RootNamespace>
    <AssemblyName>X.HYBRID V1</AssemblyName>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- DLL embarquee dans l'exe : la version hebergee n'a besoin d'aucun fichier annexe -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgBouncyCastle_Cryptography)\lib\net461\BouncyCastle.Cryptography.dll" LogicalName="BouncyCastle.Cryptography.dll" />
  </ItemGroup>

  <!-- Serveur prive (LawinServer) et moteur Node.js embarques eux aussi : le
       premier lancement les installe dans %APPDATA%\FNHybrid. Construire le
       paquet avec tools/make-payload.ps1 avant de compiler une release. -->
  <ItemGroup Condition="Exists('payload.zip')">
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

  <Target Name="CheckPayload" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' And !Exists('payload.zip')">
    <Error Text="payload.zip est absent : lance tools/make-payload.ps1 avant de compiler la release (sinon l'exe n'installe pas le serveur)." />
  </Target>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
